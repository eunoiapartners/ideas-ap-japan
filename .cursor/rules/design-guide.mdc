5. Component Specs
Navigation
css/* Utility Bar */
.utility-bar {
  background: var(--color-primary);
  color: var(--color-text-on-dark);
  font-size: var(--text-sm);
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--container-px);
}

/* Main Header */
.header {
  background: var(--color-dark);
  height: 72px;
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--space-8);
}

.nav-link {
  color: var(--color-text-on-dark);
  font-size: var(--text-base);
  font-weight: var(--font-medium);
  padding: var(--space-2) var(--space-4);
  transition: color 0.2s ease;
}

.nav-link:hover {
  color: var(--color-accent-blue);
}
CTA Buttons
css/* Primary Button (赤) */
.btn-primary {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  background: var(--color-accent-red);
  color: #FFFFFF;
  font-size: var(--text-base);
  font-weight: var(--font-bold);
  padding: var(--space-3) var(--space-6);
  border-radius: 4px;
  border: none;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.1s ease;
}
.btn-primary:hover {
  background: #B01E24;
  transform: translateY(-1px);
}

/* Ghost Button (枠線のみ) */
.btn-ghost {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  background: transparent;
  color: var(--color-primary);
  font-size: var(--text-base);
  font-weight: var(--font-bold);
  padding: var(--space-3) var(--space-6);
  border-radius: 4px;
  border: 2px solid var(--color-primary);
  cursor: pointer;
  transition: all 0.2s ease;
}
.btn-ghost:hover {
  background: var(--color-primary);
  color: #FFFFFF;
}

/* Inline CTA (丸アイコン付き — AUスタイル) */
.btn-inline {
  display: inline-flex;
  align-items: center;
  gap: var(--space-3);
  color: var(--color-text-on-dark);
  font-size: var(--text-base);
  font-weight: var(--font-semibold);
}
.btn-inline .icon-circle {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--color-accent-red);
  display: grid;
  place-items: center;
  flex-shrink: 0;
}
Cards
css/* Program Card (暗背景) */
.card-program {
  background: var(--color-dark-mid);
  color: var(--color-text-on-dark);
  border-radius: 4px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s ease;
}
.card-program:hover {
  transform: translateY(-4px);
}
.card-program .card-icon {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  border: 3px solid var(--color-accent-red);
  display: grid;
  place-items: center;
  margin: var(--space-8) auto var(--space-4);
  color: var(--color-accent-red);
}

/* News Card (白背景) */
.card-news {
  background: #FFFFFF;
  border: 1px solid var(--color-border);
  border-radius: 4px;
  overflow: hidden;
  transition: box-shadow 0.2s ease;
}
.card-news:hover {
  box-shadow: 0 8px 24px rgba(30, 58, 95, 0.12);
}
.card-news .card-tag {
  display: inline-block;
  background: var(--color-accent-red);
  color: #FFFFFF;
  font-size: var(--text-xs);
  font-weight: var(--font-bold);
  padding: 2px 10px;
  border-radius: 2px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
Icon Style
アイコンは outline（細い線画）スタイルを使用。
推奨ライブラリ: Lucide React / Heroicons (outline)
色: --color-accent-red または --color-primary
サイズ: 24px (本文中), 32px (クイックリンク), 48px (フィーチャー)
Testimonial Section
css.testimonial {
  background: var(--color-section-bg);
  padding: var(--section-padding-y) var(--container-px);
}
.testimonial-photo {
  width: 200px;
  height: 200px;
  border-radius: 50%;
  object-fit: cover;
  border: 5px solid var(--color-accent-red);  /* 赤いリングで強調 */
}
.testimonial-quote {
  font-family: var(--font-sub);
  font-size: var(--text-2xl);
  line-height: var(--leading-relaxed);
  color: var(--color-text-primary);
}
.quote-mark {
  color: var(--color-accent-red);
  font-size: 3rem;
  line-height: 0;
}

6. Hero Section Spec
css.hero {
  position: relative;
  width: 100%;
  height: 90vh;
  min-height: 560px;
  overflow: hidden;
}
.hero-overlay {
  position: absolute;
  inset: 0;
  background: rgba(30, 58, 95, 0.55);  /* --color-dark ベース */
}
.hero-content {
  position: relative;
  z-index: 1;
  max-width: var(--container-max);
  margin: 0 auto;
  padding: 0 var(--container-px);
  height: 100%;
  display: flex;
  align-items: flex-end;
  padding-bottom: var(--space-16);
}
.hero-title {
  font-size: var(--text-hero);
  font-weight: var(--font-extrabold);
  color: #FFFFFF;
  line-height: var(--leading-tight);
  max-width: 540px;
}
.hero-divider {
  width: 2px;
  height: 100px;
  background: var(--color-accent-red);
  margin: 0 var(--space-8);
  align-self: flex-end;
}
.hero-sub {
  max-width: 420px;
  align-self: flex-end;
  padding-bottom: var(--space-3);
}
.hero-sub p {
  color: rgba(255,255,255,0.9);
  font-size: var(--text-lg);
  margin-bottom: var(--space-6);
}

7. Grid System
css/* 12カラムグリッド */
.container {
  max-width: var(--container-max);
  margin: 0 auto;
  padding: 0 var(--container-px);
}

.grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-6); }
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
.grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-8); }

/* レスポンシブ */
@media (max-width: 1024px) {
  .grid-4 { grid-template-columns: repeat(2, 1fr); }
  .grid-3 { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
  .grid-4, .grid-3, .grid-2 { grid-template-columns: 1fr; }
  .hero-title { font-size: var(--text-4xl); }
}

8. Footer Spec
css.footer {
  background: var(--color-dark);
  color: var(--color-text-on-dark);
  padding: var(--space-16) 0 var(--space-8);
}
.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: var(--space-8);
  margin-bottom: var(--space-12);
}
.footer-heading {
  font-size: var(--text-sm);
  font-weight: var(--font-bold);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-accent-blue);
  margin-bottom: var(--space-4);
}
.footer-link {
  color: rgba(255,255,255,0.75);
  font-size: var(--text-sm);
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-1) 0;
  transition: color 0.2s;
}
.footer-link:hover { color: #FFFFFF; }

/* SNS アイコン */
.social-icon {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 1px solid rgba(255,255,255,0.3);
  display: grid;
  place-items: center;
  color: #FFFFFF;
  transition: border-color 0.2s, background 0.2s;
}
.social-icon:hover {
  background: var(--color-accent-red);
  border-color: var(--color-accent-red);
}

